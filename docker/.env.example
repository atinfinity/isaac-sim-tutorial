# docker/compose.yml 用の環境変数。
# このファイルを docker/.env にコピーし、必要な行のコメントを外して編集する。

# 使用する Isaac Sim イメージ
# ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:6.1.0

# キャッシュ・設定・ログを置くホスト側ディレクトリ (uid 1234 の所有にしておく)
# .env では ~ が展開されないため絶対パスで書く
# ISAAC_SIM_DATA=/home/<ユーザー名>/docker/isaac-sim
# ISAACSIM_HUB_CACHE_PATH=/home/<ユーザー名>/.cache/ov/hub

# 別の PC のブラウザから接続する場合は、ホストの LAN 側 IP アドレスを指定する
# Web ビューアはビルド時にこの値を埋め込むため、変更したら --build を付けて起動し直す
# ISAACSIM_HOST=192.168.0.10

# ポート番号 (通常は変更不要)
# ISAACSIM_SIGNAL_PORT=49100
# ISAACSIM_STREAM_PORT=47998
# WEB_VIEWER_PORT=8210

# 使用する GPU (既定はすべて)
# GPU_DEVICE=all
